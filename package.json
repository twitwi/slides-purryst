{
  "name": "slides-purryst",
  "version": "0.1.0",
  "description": "SlidesPurryst: Where Typst meets Vue in purr-fect harmony.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/slides-purryst.umd.cjs",
  "module": "./dist/slides-purryst.es.js",
  "types": "./dist/slides-purryst.d.ts",
  "exports": {
    ".": {
      "types": "./dist/slides-purryst.d.ts",
      "import": "./dist/slides-purryst.es.js",
      "require": "./dist/slides-purryst.umd.cjs"
    },
    "./style.css": "./dist/slides-purryst.css"
  },
  "sideEffects": [
    "./dist/slides-purryst.css"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs example/demo-slidespurr.html",
    "dev:typst": "node scripts/dev.mjs example/demo-slidespurryst.typ",
    "dev:bundle": "pnpm build:bundle && node scripts/dev.mjs example/demo-purrbundle.html",
    "do-serve-open": "vite --port 3334 --clearScreen false --open  ",
    "SLOW-do-prettier-inplace": "prettier --ignore-path ignorregitignore --print-width 160 --write  ",
    "clean": "rm $(git ls-files -o -i -X .gitignore example/ )",
    "clean:dry": "echo rm $(git ls-files -o -i -X .gitignore example/ )",
    "build": "vite build",
    "build:bundle": "vite build --config vite.bundle.ts",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "typescript": "^5.7.3",
    "vite": "^6.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-dts": "^4.5.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "dependencies": {
    "shiki": "^4.3.1"
  }
}
