{
  "name": "slides-purryst",
  "version": "0.1.0",
  "description": "SlidesPurryst: Where Typst meets Vue in purr-fect harmony.",
  "type": "module",
  "bin": {
    "slides-purryst": "./bin/cli.mjs",
    "sp-dev": "./bin/sp-dev.mjs"
  },
  "files": [
    "dist",
    "bin",
    "lib",
    "AGENTS.md"
  ],
  "main": "./dist/slides-purryst.umd.cjs",
  "module": "./dist/slides-purryst.es.js",
  "types": "./dist/slides-purryst.d.ts",
  "exports": {
    ".": {
      "types": "./dist/slides-purryst.d.ts",
      "import": "./dist/slides-purryst.es.js",
      "require": "./dist/slides-purryst.umd.cjs"
    },
    "./style.css": "./dist/slides-purryst.css"
  },
  "sideEffects": [
    "./dist/slides-purryst.css"
  ],
  "scripts": {
    "dev": "node bin/sp-dev.mjs --watch example/ --port 3334 --open",
    "dev:typst": "node bin/sp-dev.mjs example/demo-slidespurryst.typ --watch example/ --port 3334 --open",
    "dev:bundle": "node bin/cli.mjs example/",
    "clean": "rm $(git ls-files -o -i -X .gitignore example/ )",
    "clean:dry": "echo rm $(git ls-files -o -i -X .gitignore example/ )",
    "build": "vite build && vite build --config vite.bundle.ts",
    "build:bundle": "vite build --config vite.bundle.ts",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "shiki": "^4.3.1",
    "tinykeys": "^4.0.0"
  }
}
